[Unit]
Description=BotForge backup
After=botpanel.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/botpanel/botpanel.env
# Database snapshot + bot files. Encryption keys are NOT included: back them up
# separately (see docs/backup.md). Keeps the newest 14 backups.
ExecStart=/bin/sh -c 'umask 077; exec /usr/local/bin/botpanel backup /var/backups/botpanel/$(date +%%Y%%m%%d-%%H%%M%%S)'
ExecStartPost=/bin/sh -c 'ls -1dt /var/backups/botpanel/*/ | tail -n +15 | xargs -r rm -rf'
User=root
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/backups/botpanel /var/lib/botpanel
ReadOnlyPaths=/etc/botpanel
StateDirectory=
